# "Fix a bug" form (/fix-a-bug) → Telegram
# 1. In Telegram, message @BotFather, send /newbot and copy the token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": …}.
# Without these the form shows "offline, please email me instead".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public site URL (no trailing slash), needed at BUILD time for canonical
# links, social preview images, the sitemap and the RSS feed.
SITE_URL=https://your-domain.com
