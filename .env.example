# "Fix a bug" form (/fix-a-bug) → Telegram
# 1. In Telegram, message @BotFather, send /newbot and copy the token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": …}.
# Without these the form shows "offline, please email me instead".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: public site URL used for canonical links, social preview images,
# the sitemap and the RSS feed. Defaults to https://dhucar.in; set it only for
# another deployment (e.g. staging). Read at build time.
# SITE_URL=https://dhucar.in

# Content API (backend/, .NET 8 + MongoDB). All optional: without them the
# site uses the built-in content in src/data, exactly as before.
# Server-side base URL for reading posts, projects and the profile. If the API
# is down, pages keep their last good content (or fall back to the built-in one).
# API_URL=https://api.dhucar.in
# Public base URL for the privacy-first page-view beacon (no cookies, no ids;
# honours Do Not Track and Global Privacy Control) and the /admin pages.
# Read at build time.
# NEXT_PUBLIC_API_URL=https://api.dhucar.in
# Shared secret (32+ characters) for the signed /api/revalidate webhook the API
# calls after content changes. Must equal the API's Portfolio__Site__RevalidateSecret.
# REVALIDATE_SECRET=
